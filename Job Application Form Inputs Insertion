<?php
require_once __DIR__ . '/includes/functions.php';
require_once __DIR__ . '/config/database.php';

$errors = [];
$form = [
    'first_name' => '',
    'last_name' => '',
    'email_address' => '',
    'phone_number' => '',
    'home_address' => '',
    'position_applied' => 'Data Analyst Programmer',
    'technical_skills' => '',
    'experience_years' => '0',
];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    foreach ($form as $field => $default) {
        $form[$field] = trim((string) ($_POST[$field] ?? $default));
    }

    if (!valid_csrf_token()) {
        $errors[] = 'Your form session expired or the security token is invalid. Please refresh the page and try again.';
    }

    if ($form['first_name'] === '') {
        $errors[] = 'First name is required.';
    }
    if ($form['last_name'] === '') {
        $errors[] = 'Last name is required.';
    }
    if (!filter_var($form['email_address'], FILTER_VALIDATE_EMAIL)) {
        $errors[] = 'Enter a valid email address.';
    }
    if ($form['phone_number'] === '') {
        $errors[] = 'Phone number is required.';
    }
    if ($form['home_address'] === '') {
        $errors[] = 'Home address is required.';
    }
    if ($form['position_applied'] === '') {
        $errors[] = 'Position applied for is required.';
    }
    if ($form['technical_skills'] === '') {
        $errors[] = 'Technical skills are required.';
    }
    if ($form['experience_years'] === '' || filter_var($form['experience_years'], FILTER_VALIDATE_INT) === false
        || (int) $form['experience_years'] < 0 || (int) $form['experience_years'] > 99) {
        $errors[] = 'Years of experience must be a whole number from 0 to 99.';
    }

    if (!$errors) {
        $sql = 'INSERT INTO job_applications
                (first_name, last_name, email_address, phone_number, home_address,
                 position_applied, technical_skills, experience_years)
                VALUES
                (:first_name, :last_name, :email_address, :phone_number, :home_address,
                 :position_applied, :technical_skills, :experience_years)';

        $statement = $pdo->prepare($sql);
        $statement->execute([
            ':first_name' => $form['first_name'],
            ':last_name' => $form['last_name'],
            ':email_address' => $form['email_address'],
            ':phone_number' => $form['phone_number'],
            ':home_address' => $form['home_address'],
            ':position_applied' => $form['position_applied'],
            ':technical_skills' => $form['technical_skills'],
            ':experience_years' => (int) $form['experience_years'],
        ]);

        set_flash('success', 'Application submitted successfully.');
        redirect('index.php');
    }
}

$statement = $pdo->query('SELECT * FROM job_applications ORDER BY date_added DESC, application_id DESC');
$applications = $statement->fetchAll();
$flash = get_flash();
?>
