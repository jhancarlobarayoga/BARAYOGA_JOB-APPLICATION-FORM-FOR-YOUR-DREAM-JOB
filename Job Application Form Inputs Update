<?php
require_once __DIR__ . '/includes/functions.php';
require_once __DIR__ . '/config/database.php';

$id = filter_input(INPUT_GET, 'id', FILTER_VALIDATE_INT);
if (!$id || $id < 1) {
    set_flash('error', 'Please select a valid application to edit.');
    redirect('index.php');
}

$find = $pdo->prepare('SELECT * FROM job_applications WHERE application_id = :id');
$find->execute([':id' => $id]);
$application = $find->fetch();
if (!$application) {
    set_flash('error', 'The application was not found.');
    redirect('index.php');
}

$errors = [];
$form = [
    'first_name' => $application['first_name'],
    'last_name' => $application['last_name'],
    'email_address' => $application['email_address'],
    'phone_number' => $application['phone_number'],
    'home_address' => $application['home_address'],
    'position_applied' => $application['position_applied'],
    'technical_skills' => $application['technical_skills'],
    'experience_years' => (string) $application['experience_years'],
];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    foreach ($form as $field => $value) {
        $form[$field] = trim((string) ($_POST[$field] ?? ''));
    }

    if (!valid_csrf_token()) {
        $errors[] = 'Your form session expired or the security token is invalid. Please refresh the page and try again.';
    }
    if ($form['first_name'] === '') $errors[] = 'First name is required.';
    if ($form['last_name'] === '') $errors[] = 'Last name is required.';
    if (!filter_var($form['email_address'], FILTER_VALIDATE_EMAIL)) $errors[] = 'Enter a valid email address.';
    if ($form['phone_number'] === '') $errors[] = 'Phone number is required.';
    if ($form['home_address'] === '') $errors[] = 'Home address is required.';
    if ($form['position_applied'] === '') $errors[] = 'Position applied for is required.';
    if ($form['technical_skills'] === '') $errors[] = 'Technical skills are required.';
    if ($form['experience_years'] === '' || filter_var($form['experience_years'], FILTER_VALIDATE_INT) === false
        || (int) $form['experience_years'] < 0 || (int) $form['experience_years'] > 99) {
        $errors[] = 'Years of experience must be a whole number from 0 to 99.';
    }

    if (!$errors) {
        $sql = 'UPDATE job_applications SET
                    first_name = :first_name,
                    last_name = :last_name,
                    email_address = :email_address,
                    phone_number = :phone_number,
                    home_address = :home_address,
                    position_applied = :position_applied,
                    technical_skills = :technical_skills,
                    experience_years = :experience_years
                WHERE application_id = :application_id';
        $update = $pdo->prepare($sql);
        $update->execute([
            ':first_name' => $form['first_name'],
            ':last_name' => $form['last_name'],
            ':email_address' => $form['email_address'],
            ':phone_number' => $form['phone_number'],
            ':home_address' => $form['home_address'],
            ':position_applied' => $form['position_applied'],
            ':technical_skills' => $form['technical_skills'],
            ':experience_years' => (int) $form['experience_years'],
            ':application_id' => $id,
        ]);

        set_flash('success', 'Application updated successfully.');
        redirect('index.php');
    }
}
