:root {
    --navy: #172554;
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --ink: #1f2937;
    --muted: #64748b;
    --line: #e2e8f0;
    --page: #f4f7fb;
    --white: #ffffff;
    --green-bg: #dcfce7;
    --green-text: #166534;
    --red-bg: #fee2e2;
    --red-text: #991b1b;
}

* { box-sizing: border-box; }
body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.55;
}
.container { width: min(1180px, calc(100% - 36px)); margin: 0 auto; }
.site-header {
    background: linear-gradient(125deg, #172554, #1d4ed8);
    color: var(--white);
    padding: 38px 0 34px;
}
.site-header h1 { margin: 4px 0 7px; font-size: clamp(27px, 4vw, 38px); line-height: 1.2; }
.eyebrow { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: 1.7px; text-transform: uppercase; opacity: .82; }
.subtitle { margin: 0; color: #dbeafe; }
.page-content { padding-top: 26px; padding-bottom: 42px; }
.panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 25px;
    margin-bottom: 24px;
    box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
}
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 21px; }
.section-heading h2 { margin: 3px 0 0; font-size: 23px; color: var(--navy); }
.section-heading .eyebrow { color: var(--blue); opacity: 1; }
.muted { color: var(--muted); }
.small-text { font-size: 12px; }
.pill, .count-badge { background: #eff6ff; color: #1d4ed8; border-radius: 999px; padding: 7px 12px; font-size: 12px; font-weight: 700; white-space: nowrap; }
.application-form { margin: 0; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 17px 20px; margin-bottom: 22px; }
.form-field { min-width: 0; }
.full-width { grid-column: 1 / -1; }
label { display: block; margin-bottom: 7px; font-weight: 700; font-size: 13px; }
input, textarea {
    display: block;
    width: 100%;
    border: 1px solid #cbd5e1;
    background: #fff;
    border-radius: 8px;
    padding: 11px 12px;
    color: var(--ink);
    font: inherit;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
}
input:focus, textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37, 99, 235, .12); }
textarea { resize: vertical; }
small { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; }
.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 39px;
    padding: 9px 14px;
    border: 0;
    border-radius: 8px;
    text-decoration: none;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
}
.button.primary { background: var(--blue); color: white; }
.button.primary:hover { background: var(--blue-dark); }
.button.secondary { background: #eaf0f8; color: #334155; }
.button.secondary:hover { background: #dbe4f0; }
.button.danger { background: #fee2e2; color: #b91c1c; }
.button.danger:hover { background: #fecaca; }
.button.small { min-height: 31px; padding: 6px 10px; font-size: 12px; }
.alert { padding: 13px 16px; margin-bottom: 20px; border-radius: 9px; border: 1px solid transparent; }
.alert.success { background: var(--green-bg); color: var(--green-text); border-color: #bbf7d0; }
.alert.error { background: var(--red-bg); color: var(--red-text); border-color: #fecaca; }
.alert ul { margin: 7px 0 0; padding-left: 22px; }
.empty-state { border: 1px dashed #cbd5e1; border-radius: 10px; text-align: center; padding: 34px 18px; color: var(--muted); }
.empty-state h3 { margin: 0 0 5px; color: var(--ink); }
.empty-state p { margin: 0; }
.table-wrap { width: 100%; overflow-x: auto; }
table { width: 100%; min-width: 1050px; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; vertical-align: top; padding: 13px 12px; border-bottom: 1px solid var(--line); }
th { background: #f8fafc; color: #475569; font-size: 11px; text-transform: uppercase; letter-spacing: .55px; }
tbody tr:hover { background: #f8fbff; }
tbody tr:last-child td { border-bottom: 0; }
.skills-cell { max-width: 200px; white-space: normal; }
.action-buttons { display: flex; align-items: center; gap: 6px; }
.action-buttons form { margin: 0; }
.narrow-content { max-width: 900px; }
.form-actions { display: flex; align-items: center; gap: 10px; }
.site-footer { border-top: 1px solid var(--line); background: #fff; color: var(--muted); padding: 18px 0; text-align: center; font-size: 12px; }

@media (max-width: 650px) {
    .container { width: min(100% - 22px, 1180px); }
    .site-header { padding: 28px 0; }
    .panel { padding: 17px; border-radius: 11px; }
    .form-grid { grid-template-columns: 1fr; }
    .full-width { grid-column: auto; }
    .section-heading { align-items: flex-start; flex-direction: column; }
    .form-actions { flex-wrap: wrap; }
}
